{
  "name": "migpt-server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc",
    "dev:watch": "tsc -w",
    "start": "node dist/index.js --open --user a --pwd b"
  },
  "bin": {
    "migpt-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@migptgui/gui": "^2.0.0",
    "@migptgui/server": "^2.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.3",
    "typescript": "^5.6.2"
  }
}
