{
  "name": "@migptgui/gui",
  "version": "2.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "checktype": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "webpack --env mode=development",
    "dev:watch": "webpack --watch --env mode=development",
    "dev:serve": "webpack serve --env mode=development",
    "build": "npm run checktype && webpack --env mode=production"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@blueprintjs/core": "^5.13.0",
    "@blueprintjs/datetime2": "^3.3.0",
    "@blueprintjs/icons": "^5.13.0",
    "@migptgui/contracts": "*",
    "@migptgui/options": "*",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.38.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.1",
    "normalize.css": "^8.0.1",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.79.3",
    "sass-loader": "^16.0.2",
    "tailwindcss": "^3.4.13",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "recharts": "^3.10.1"
