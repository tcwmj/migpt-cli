# migpt-cli Docker 环境变量配置示例
# 复制此文件为 .env 并修改配置

# 镜像地址（阿里云容器镜像服务）
# 格式：registry.cn-hangzhou.aliyuncs.com/命名空间/仓库名:标签
MIGPT_IMAGE=registry.cn-hangzhou.aliyuncs.com/tcwmj/migpt-cli:latest

# 访问密码（必填，用于登录认证）
AUTH_PASSWORD=your_secure_password_here

# 服务端口（默认 36597）
PORT=36597

# 构建参数（仅本地构建时使用）
# VERSION=2.0.0
# REVISION=unknown