{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".cache/nx",
  "defaultBase": "main",
  "release": {
    "groups": {
      "migptgui": {
        "projects": [
          "@migptgui/contracts",
          "@migptgui/controller",
          "@migptgui/gui",
          "@migptgui/options",
          "@migptgui/options-with-preview",
          "@migptgui/server",
          "migpt-server"
        ],
        "projectsRelationship": "fixed",
        "releaseTagPattern": "migptgui@{version}",
        "version": {
          "conventionalCommits": true,
          "generatorOptions": {
            "fallbackCurrentVersionResolver": "disk"
          }
        },
        "changelog": false
      },
      "cli": {
        "projects": ["migpt-cli"],
        "projectsRelationship": "independent",
        "releaseTagPattern": "migpt-cli@{version}",
        "version": {
          "conventionalCommits": true,
          "generatorOptions": {
            "fallbackCurrentVersionResolver": "disk"
          }
        },
        "changelog": false
      }
    }
  },
  "targetDefaults": {
    "dev": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    }
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  }
}
